{
  "name": "@manohar_maharshi/genoid",
  "version": "1.28.0",
  "description": "GenoID — a declarative RFC 9562 v8 UUID library: GA-inspired pooled-CSPRNG generation plus structured layouts (shard, tenant, counter, timestamp) with constraint-guided repair, no rejection sampling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/algo.js",
    "dist/algo.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "bun test src/scripts --timeout=30000",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "bench": "bun run src/scripts/bench.ts",
    "bench-ci": "bun run src/scripts/bench-ci.ts",
    "bench-db": "bun run src/scripts/bench-db.ts",
    "bench-rejection": "bun run src/scripts/bench-rejection.ts",
    "bench-bit-allocation": "bun run src/scripts/bench-bit-allocation.ts",
    "bench-db-native": "bun run src/scripts/bench-db-native.ts",
    "evidence:fixture": "bun run src/scripts/evidence-fixture.ts",
    "evidence:verify": "bun run src/scripts/verify-evidence.ts",
    "bench-concurrent": "bun run src/scripts/bench-concurrent.ts",
    "bench-sqlite": "bun run src/scripts/bench-sqlite.ts",
    "bench-sqlite-artifact": "bun run src/scripts/bench-sqlite-artifact.ts",
    "collision-100m": "bun run src/scripts/collision-100m.ts",
    "histogram-100m": "bun run src/scripts/histogram-100m.ts",
    "histogram:maxz": "bun run src/scripts/histogram-maxz.ts",
    "export-dieharder": "bun run src/scripts/export-dieharder.ts",
    "export-multi-stream": "bun run src/scripts/export-multi-stream.ts",
    "export-golden": "bun run src/scripts/export-golden.ts",
    "golden:hash": "bun run src/scripts/hash-golden.ts",
    "golden:verify": "bun run src/scripts/verify-golden-hashes.ts",
    "docs:benchmarks": "bun run src/scripts/generate-docs.ts",
    "dieharder": "bun run src/scripts/run-dieharder.ts",
    "practrand": "bun run src/scripts/run-practrand.ts",
    "test:stats": "bun run src/scripts/stats.ts",
    "stats:evidence": "bun run src/scripts/stats-evidence.ts",
    "playwright": "bun run src/scripts/playwright.ts",
    "verify-playwright": "tsx src/scripts/playwright.dryrun.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "bunx oxlint --fix"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.61.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "mysql2": "^3.24.4",
    "oxfmt": "^0.1.0",
    "oxlint": "^1.74.0",
    "pg": "^8.23.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "ultracite": "^7.9.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
